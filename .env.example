# Copy this file to .env.local and fill in the values.
# Never commit .env.local.
# Never put the Supabase service_role key in this app. It bypasses row-level security.

# Supabase project URL, from Project Settings → API.
# Example: https://xxxx.supabase.co
# http:// is accepted only for localhost, so the Supabase CLI works.
SUPABASE_URL=

# Publishable key, still labeled "anon" on older projects.
# This key is safe to use in the app because row-level security limits it.
# Do not put the service_role key here.
SUPABASE_PUBLISHABLE_KEY=

# TMDB, from https://www.themoviedb.org/settings/api
# Set one of these. If both are set, the read access token is used.
# Both stay on the server. Do not prefix them with NEXT_PUBLIC_.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# MDBList, from https://mdblist.com/preferences/ (API section). Optional.
# Adds IMDb, Rotten Tomatoes, Metacritic, Letterboxd and Trakt scores and a
# combined score to title pages. Without it, pages show TMDB's score only.
MDBLIST_API_KEY=
